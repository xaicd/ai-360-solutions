// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User & Auth Management
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  role          String    // SUPER_ADMIN, SOLUTION_ARCHITECT, SYSTEM_OP, AUDITOR, CONSUMER
  passwordHash  String
  email         String?   @unique
  phone         String?   @unique
  avatar        String?
  lastLogin     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
  orders        ProcurementOrder[]
  resources     CloudResource[]
  agents        DigitalAgent[]
}

// System Audit Logs
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  ip        String?
  details   String?  // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// Core Product: AI Solutions
model Solution {
  id                  String   @id @default(uuid())
  title               String
  description         String
  fullOverview        String?  // Markdown content
  industry            String
  githubRepo          String?
  stars               Int      @default(0)
  tags                String   // JSON string of string[]
  scenarios           String   // JSON string of string[]
  deploymentModes     String   // JSON string: ['CLOUD', 'EDGE_PRIVATE']
  deploymentDifficulty String  // 'Low', 'Medium', 'High'
  matchScore          Int      @default(0)
  
  // Security Specs
  encryptionLevel     String   // 'AES-256', 'SM4', etc.
  tunnelType          String   // 'Reverse-SSH', 'Cloud-Proxy'
  packageSigned       Boolean  @default(true)

  // Pricing
  price               Float
  currency            String   // 'CNY', 'USDT'
  
  status              String   // 'draft', 'active', 'pending', 'deprecated'
  
  // Architect Review
  qualityScore        Int
  securityVerdict     String
  codeMaintainability String
  isAudited           Boolean  @default(false)
  auditDate           DateTime?

  // AI Configuration
  executionPlan       String?  // JSON string of ExecutionPlan
  verticalLLMConfig   String?  // JSON string, proprietary model configs
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agents              DigitalAgent[]
}

// Digital Workforce (The "Team" bundled with solutions)
model DigitalAgent {
  id              String   @id @default(uuid())
  solutionId      String
  role            String   // e.g. 'Data Analyst'
  name            String
  avatarSeed      String
  personality     String
  status          String   // 'HIBERNATING', 'AWAKE', 'WORKING'
  saturation      Int      @default(0) // Training saturation 0-100
  currentTask     String?
  
  trainingHistory String?  // JSON string of TrainingData[]

  // User Ownership & MCP
  ownerId         String?
  mcpEndpoint     String?
  mcpConfig       String?   // JSON string: { endpoint, tools: [] }

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  solution        Solution @relation(fields: [solutionId], references: [id])
  trainingJobs    TrainingJob[]
  knowledgeBases  KnowledgeBase[] // Implicit many-to-many
}

model KnowledgeBase {
  id              String   @id @default(uuid())
  name            String
  description     String?
  embeddingModel  String   @default("text-embedding-3-small")
  vectorDb        String   @default("pgvector")
  status          String   @default("READY")
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  documents       Document[]
  agents          DigitalAgent[]
}

model Document {
  id              String   @id @default(uuid())
  knowledgeBaseId String
  title           String
  content         String?  // Text content or extracted text
  filePath        String?  // S3 path or local path
  fileType        String   // pdf, md, txt
  fileSize        Int
  status          String   // PENDING, PROCESSING, EMBEDDED, FAILED
  chunkCount      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id])
}

model TrainingJob {
  id          String   @id @default(uuid())
  agentId     String
  status      String   // QUEUED, RUNNING, COMPLETED, FAILED
  config      String   // JSON: { baseModel, dataset, epochs, learningRate, loraRank }
  metrics     String?  // JSON: { loss: [{step:1, val:0.9}], eval: ... }
  logs        String?  // Console output
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  agent       DigitalAgent @relation(fields: [agentId], references: [id])
}

// --- Cloud Resource Management & IaC ---

model CloudProvider {
  id          String   @id @default(uuid())
  name        String
  type        String   // AWS, ALIYUN, GCP, AZURE, VMWARE, OPENSTACK, LOCAL
  credentials String   // JSON string: { accessKey, secretKey, region, endpoint } - Encrypt in app
  status      String   // ACTIVE, ERROR, SYNCING
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  resources   CloudResource[]
  stacks      InfrastructureStack[]
}

model CloudResource {
  id          String   @id @default(uuid())
  providerId  String
  ownerId     String?  // Linked to User (Consumer)
  name        String
  type        String   // COMPUTE, STORAGE, NETWORK, DATABASE
  region      String
  status      String   // RUNNING, STOPPED, PROVISIONING, TERMINATED
  ipAddress   String?
  specs       String   // JSON: { cpu, ram, disk, os }
  terraformId String?  // ID in terraform state
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  provider    CloudProvider @relation(fields: [providerId], references: [id])
  owner       User?         @relation(fields: [ownerId], references: [id])
}

model InfrastructureStack {
  id          String   @id @default(uuid())
  name        String
  providerId  String
  tfState     String?  // Terraform State JSON
  tfConfig    String   // Terraform HCL Configuration
  status      String   // APPLIED, PLAN_FAILED, APPLY_FAILED, DRIFTED
  lastApply   DateTime?
  
  provider    CloudProvider @relation(fields: [providerId], references: [id])
}

// --- Procurement & Finance ---

model ProcurementOrder {
  id            String   @id @default(uuid())
  orderNumber   String   @unique
  requesterId   String
  resourceType  String
  specs         String   // JSON requirements
  budget        Float
  currency      String
  status        String   // PENDING, MATCHING, FULFILLED, CANCELLED
  matchedResourceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  
  requester     User     @relation(fields: [requesterId], references: [id])
  billing       BillingLedger[]
}

model BillingLedger {
  id            String   @id @default(uuid())
  orderId       String
  amount        Float
  currency      String
  type          String   // PAYMENT, REFUND, ADJUSTMENT
  status        String   // PROCESSED, PENDING, FAILED
  transactionId String?
  createdAt     DateTime @default(now())

  order         ProcurementOrder @relation(fields: [orderId], references: [id])
}
