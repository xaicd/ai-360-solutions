// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// User & Auth Management
model User {
  id            String    @id @default(uuid())
  username      String    @unique
  role          String    // SUPER_ADMIN, SOLUTION_ARCHITECT, SYSTEM_OP, AUDITOR, CONSUMER
  passwordHash  String
  avatar        String?
  lastLogin     DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  auditLogs     AuditLog[]
}

// System Audit Logs
model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  username  String
  action    String
  ip        String?
  details   String?  // JSON string
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
}

// Core Product: AI Solutions
model Solution {
  id                  String   @id @default(uuid())
  title               String
  description         String
  fullOverview        String?  // Markdown content
  industry            String
  githubRepo          String?
  stars               Int      @default(0)
  tags                String   // JSON string of string[]
  scenarios           String   // JSON string of string[]
  deploymentModes     String   // JSON string: ['CLOUD', 'EDGE_PRIVATE']
  deploymentDifficulty String  // 'Low', 'Medium', 'High'
  matchScore          Int      @default(0)
  
  // Security Specs
  encryptionLevel     String   // 'AES-256', 'SM4', etc.
  tunnelType          String   // 'Reverse-SSH', 'Cloud-Proxy'
  packageSigned       Boolean  @default(true)

  // Pricing
  price               Float
  currency            String   // 'CNY', 'USDT'
  
  status              String   // 'draft', 'active', 'pending', 'deprecated'
  
  // Architect Review
  qualityScore        Int
  securityVerdict     String
  codeMaintainability String
  isAudited           Boolean  @default(false)
  auditDate           DateTime?

  // AI Configuration
  executionPlan       String?  // JSON string of ExecutionPlan
  verticalLLMConfig   String?  // JSON string, proprietary model configs
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  agents              DigitalAgent[]
}

// Digital Workforce (The "Team" bundled with solutions)
model DigitalAgent {
  id              String   @id @default(uuid())
  solutionId      String
  role            String   // e.g. 'Data Analyst'
  name            String
  avatarSeed      String
  personality     String
  status          String   // 'HIBERNATING', 'AWAKE', 'WORKING'
  saturation      Int      @default(0) // Training saturation 0-100
  currentTask     String?
  
  trainingHistory String?  // JSON string of TrainingData[]

  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  solution        Solution @relation(fields: [solutionId], references: [id])
}
